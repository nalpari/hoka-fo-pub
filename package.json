{
  "name": "eland-adaptive-wireframe",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "prepare": "panda codegen && panda cssgen --outfile src/shared/styles/panda.css",
    "panda": "panda codegen && panda cssgen --outfile src/shared/styles/panda.css",
    "panda:watch": "panda cssgen --watch --outfile src/shared/styles/panda.css",
    "prebuild": "panda codegen && panda cssgen --outfile src/shared/styles/panda.css",
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run storybook\" \"npm run panda:watch\"",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@pandacss/dev": "^1.12.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "postcss": "^8.5.28",
    "prettier": "latest",
    "sass": "^1.105.1",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
