{
  "name": "eland-adaptive-wireframe",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "prepare": "panda codegen && panda cssgen --outfile src/styles/panda.css && npm run hooks:install",
    "hooks:install": "node scripts/install-okf-hooks.mjs",
    "okf:check": "node scripts/okf-sync.mjs check",
    "test:okf": "node --test tests/okf-sync.test.mjs",
    "panda": "panda codegen && panda cssgen --outfile src/styles/panda.css",
    "panda:watch": "panda cssgen --watch --outfile src/styles/panda.css",
    "prebuild": "npm run screen-files && panda codegen && panda cssgen --outfile src/styles/panda.css",
    "dev": "npm run screen-files && npm run panda && concurrently \"npm run screen-files:watch\" \"next dev\" \"npm run panda:watch\"",
    "dev:all": "npm run screen-files && npm run panda && concurrently \"next dev\" \"npm run storybook\" \"npm run panda:watch\"",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "screen-files": "node scripts/screen-files.mjs",
    "screen-files:watch": "node scripts/screen-files.mjs --watch",
    "storybook": "concurrently \"npm run screen-files:watch\" \"storybook dev -p 6006\"",
    "prestorybook": "npm run screen-files",
    "prebuild-storybook": "npm run screen-files",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "motion": "^13.5.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simplebar-react": "^3.3.2",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@pandacss/dev": "^1.12.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "latest",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "postcss": "^8.5.28",
    "prettier": "latest",
    "sass": "^1.105.1",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
