{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/okf-sync.mjs\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
